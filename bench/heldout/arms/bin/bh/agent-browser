#!/bin/zsh
# run.py calls `agent-browser close --all` after a cdp-channel run; for this arm it resets the harness daemon.
# Calls the real binary, not the logging wrapper, so harness cleanup never counts as tool time.
port=$(cat "${0:A:h:h:h:h}/out/web-current-port" 2>/dev/null)
BH_TELEMETRY=0 BH_UPDATE_CHECK=0 BH_HOME="$HOME/.agent-desktop-bench-target/bh/$port" BU_CDP_URL="http://127.0.0.1:$port" \
  "$HOME/.agent-desktop-bench-target/bh-venv/bin/browser-harness" --reload >/dev/null 2>&1
exit 0
